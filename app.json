{
  "expo": {
    "name": "Water Logger",
    "slug": "water-logger",
    "scheme": "water-logger",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.devpaul.waterlogger",
      "adaptiveIcon": {
        "backgroundColor": "#0B6BAE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "@react-native-vector-icons/ionicons",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/android-icon-monochrome.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F3F7FA",
          "dark": {
            "image": "./assets/android-icon-foreground.png",
            "backgroundColor": "#0A1620"
          }
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "c71ac223-952b-4f13-a131-daf9fd195729"
      }
    }
  }
}
